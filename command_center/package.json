{
  "name": "arie-command-center",
  "version": "1.0.0",
  "private": true,
  "description": "ARIE Command Center — owner ops console + sales demo for the N8iV attribution pipeline",
  "type": "module",
  "scripts": {
    "setup": "npm install && npm install --prefix client",
    "build": "npm run build --prefix client",
    "dev": "node server/index.js",
    "start": "node server/index.js",
    "replit": "npm run setup && npm run build && npm start",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "google-auth-library": "^9.15.0"
  },
  "engines": {
    "node": ">=20"
  }
}

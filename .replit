run = ["bash", "-c", "cd command_center && npm run setup && npm run build && npm start"]
entrypoint = "command_center/server/index.js"
modules = ["nodejs-20"]
hidden = [".git", "node_modules", "command_center/node_modules", "command_center/client/node_modules"]

[env]
PORT = "3000"

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-c", "cd command_center && npm run setup && npm run build"]
run = ["bash", "-c", "cd command_center && npm start"]

[[ports]]
localPort = 3000
externalPort = 80

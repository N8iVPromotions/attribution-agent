# ── Meta / Facebook ───────────────────────────────────────────────────────────
META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret
META_ACCESS_TOKEN=your_long_lived_access_token   # generate via Graph API Explorer

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CLIENT_ID=your_oauth_client_id
GOOGLE_ADS_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your_manager_account_id_optional

# LinkedIn Ads
LINKEDIN_ACCESS_TOKEN=your_linkedin_marketing_api_token

# TikTok Ads
TIKTOK_ACCESS_TOKEN=your_tiktok_marketing_api_access_token   # Advertiser-scoped token

# ── HubSpot ───────────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=your_private_app_token      # Settings > Integrations > Private Apps

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx           # Stripe Dashboard > Developers > API keys
# For multi-agency setups with separate Stripe accounts, use per-agency keys:
# STRIPE_SECRET_KEY_ACME_MEDIA=sk_live_xxxxxxxxxxxx

# ── Databricks ────────────────────────────────────────────────────────────────
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net   # used by CLI + bundle deploy
DATABRICKS_SERVER_HOSTNAME=your-workspace.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your_warehouse_id
DATABRICKS_TOKEN=your_databricks_pat                         # Databricks > Settings > Developer > Access Tokens

# Unity Catalog catalog to write to. Default: main
# If your workspace does not have Unity Catalog, use: hive_metastore
ATTRIBUTION_CATALOG=main

# Schema for pipeline run history. Default: main.attribution_ops
ATTRIBUTION_OPS_SCHEMA=main.attribution_ops

# ARIE Command Center authentication. Users, sessions, and auth events are
# stored in Databricks under ATTRIBUTION_OPS_SCHEMA.
ARIE_AUTH_ENABLED=true
ARIE_BOOTSTRAP_ADMIN_EMAIL=zajen@n8ivpromotions.com
ARIE_BOOTSTRAP_ADMIN_PASSWORD=use-a-long-random-password
ARIE_SESSION_TTL_HOURS=12
ARIE_AUTH_MAX_FAILED=5
ARIE_AUTH_LOCK_MINUTES=15

# Where command-center client records are stored.
# Local dev: leave as default (writes next to this file, gitignored).
# Databricks App: use a Volume path so it persists across restarts.
#   /Volumes/main/attribution_ops/client_registry/clients.json
ATTRIBUTION_CLIENT_REGISTRY_PATH=attribution_agent/attribution_agent/config/client_registry.local.json

# Cloud Run scaling and durability. These are configured by deploy.sh in GCP.
# Leave locks and raw archival disabled/unset for ordinary local development.
ARIE_CLIENT_LOCKS_ENABLED=false
ARIE_CLIENT_LOCK_BUCKET=
ARIE_CLIENT_LOCK_TTL_SECONDS=300
ARIE_RAW_ARCHIVE_BUCKET=
ARIE_INGEST_SOURCE_WORKERS=3
ARIE_INGEST_BATCH_ROWS=5000
ARIE_STREAMING_INGEST=false
ARIE_ALLOW_PARTIAL_REPORT_DELIVERY=false
ARIE_WORK_MANIFEST_BUCKET=
ARIE_DELIVERY_IDEMPOTENCY_BUCKET=
ATTRIBUTION_BENCHMARK_FINALIZER_JOB=attribution-benchmark-finalizer

# AI budget enforcement. Cloud Run fails closed when the ledger is unavailable.
ARIE_MODEL_BUDGET_FAIL_CLOSED=false
ARIE_DAILY_AI_USD_LIMIT=25
ARIE_MONTHLY_AI_USD_LIMIT=300
ARIE_AI_BUDGET_BUCKET=
ARIE_AI_BUDGET_RESERVATION_TTL_MINUTES=1440

# Path to .claude/agents/ directory containing N8iV agent prompt files.
# Local dev: leave unset — auto-detected by walking up from n8iv_agents.py.
# Databricks Jobs: set to the absolute path where the bundle deploys agent files.
# N8IV_AGENTS_DIR=/Workspace/Users/you@domain.com/.bundle/attribution-agent/production/.claude/agents

# ── Email delivery ────────────────────────────────────────────────────────────
GMAIL_SENDER=you@yourdomain.com
GMAIL_APP_PASSWORD=your_gmail_app_password       # Google Account > Security > App Passwords

# ── Claude API ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxx

# ── ARIE — Telegram bot control ──────────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → name it "ARIE" → copy the token
# 2. Message @userinfobot on Telegram to get your personal chat ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id           # numeric ID, e.g. 123456789

# ── ARIE — Voice commands (optional) ─────────────────────────────────────────
# Required only for voice message transcription via OpenAI Whisper.
# Text commands work without this key.
OPENAI_API_KEY=sk-xxxxxxxxxxxx

# ── Alerting (optional) ───────────────────────────────────────────────────────
# Supported channels: telegram, genie_one. Telegram uses TELEGRAM_BOT_TOKEN/CHAT_ID.
ARIE_ALERTS_ENABLED=true
ARIE_ALERT_CHANNELS=telegram
ARIE_TOKEN_EXPIRY_WARNING_DAYS=14
ARIE_UNATTRIBUTED_REVENUE_ALERT_PCT=0.30

# Optional Genie One mobile app webhook. Leave unset until Genie One exposes a
# webhook/API endpoint for push alerts.
GENIE_ONE_WEBHOOK_URL=
GENIE_ONE_API_KEY=

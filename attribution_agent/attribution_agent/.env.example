# ── Meta / Facebook ───────────────────────────────────────────────────────────
META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret
META_ACCESS_TOKEN=your_long_lived_access_token   # generate via Graph API Explorer

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CLIENT_ID=your_oauth_client_id
GOOGLE_ADS_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your_manager_account_id_optional

# LinkedIn Ads
LINKEDIN_ACCESS_TOKEN=your_linkedin_marketing_api_token

# ── HubSpot ───────────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=your_private_app_token      # Settings > Integrations > Private Apps

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx           # Stripe Dashboard > Developers > API keys
# For multi-agency setups with separate Stripe accounts, use per-agency keys:
# STRIPE_SECRET_KEY_ACME_MEDIA=sk_live_xxxxxxxxxxxx

# ── Databricks ────────────────────────────────────────────────────────────────
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net   # used by CLI + bundle deploy
DATABRICKS_SERVER_HOSTNAME=your-workspace.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your_warehouse_id
DATABRICKS_TOKEN=your_databricks_pat                         # Databricks > Settings > Developer > Access Tokens

# Optional: where command-center client records are stored.
# For Databricks Apps, point this at a durable writable path such as a Volume.
ATTRIBUTION_CLIENT_REGISTRY_PATH=attribution_agent/attribution_agent/config/client_registry.local.json

# ── Email delivery ────────────────────────────────────────────────────────────
GMAIL_SENDER=you@yourdomain.com
GMAIL_APP_PASSWORD=your_gmail_app_password       # Google Account > Security > App Passwords

# ── Claude API ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxx

# ── Alerting (optional) ───────────────────────────────────────────────────────
ALERT_EMAIL=you@yourdomain.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

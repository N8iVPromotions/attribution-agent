# Secrets — never bake into the image
**/.env

# VCS / local state
.git/
.databricks/
.claude/*
!.claude/agents
.idea/
.vscode/

# Python caches
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/*.pyc
.venv/
.venv*/
venv/
env/
ENV/

# Not needed at runtime
arie-portal/
command_center/
docs/
prototypes/
website-work/
reports/
scripts/
attribution-agent/
attribution_agent/attribution_agent/tests/
attribution_agent/attribution_agent/evals/
attribution_agent/attribution_agent/conftest.py

# Agent/editor workspaces and local task output
.agents/
.codex-tmp/
.github/
.impeccable/

# Local ARIE runner artifacts
arie*.log
arie.pid
arie_start.ps1
arie_stop.ps1
~$CLAUDE.md
